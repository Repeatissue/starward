; Engine configuration file.
; Edit through Project > Project Settings in the Godot editor where possible.

config_version=5

[application]

config/name="STARWARD"
config/description="A journey-survival roguelite: get your colony ship to Earth 2."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

RNG="*res://core/RNG.gd"
Data="*res://core/Data.gd"
GameState="*res://core/GameState.gd"
EventEngine="*res://core/EventEngine.gd"
TravelSim="*res://core/TravelSim.gd"
SaveManager="*res://core/SaveManager.gd"
Platform="*res://core/Platform.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
